HOST=127.0.0.1
PORT=3000
LOW_MEM_MODE=true
STATIC_DIR=../frontend/dist
SNOWFLAKE_WORKER_ID=1
DATABASE_URL=sqlite://./data/keepdays.db?mode=rwc
LOCAL_S3_DIR=./data/uploads
AGENT_FS_DIR=./data/agent_fs
REDIS_URL=memory://
JWT_SECRET=replace_with_your_own_64_char_random_secret_in_production
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800
S3_ENDPOINT=/local-s3
S3_REGION=auto
S3_BUCKET=keepdays-private
S3_ACCESS_KEY=keepdays_local
S3_SECRET_KEY=replace_with_your_own_s3_secret
S3_PATH_STYLE=true
S3_PRESIGN_TTL_SECS=1800
CORS_ALLOWED_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:3000
