# =============================================================================
# KeepDays Production Environment Template (/etc/keepdays/keepdays.env)
# Target: Debian 13 (1 vCPU / 512MB-1GB RAM / SSD)
# Note: Bound strictly to 127.0.0.1:3090 behind local reverse proxy / tunnel
# =============================================================================

HOST=127.0.0.1
PORT=3090

# 512MB RAM Micro-VPS Mode (8MB SQLite page cache, 16MB WAL cap, Argon2 semaphore=1)
LOW_MEM_MODE=true

# Frontend static bundle path
STATIC_DIR=/opt/keepdays/dist

# Persistent Data Directory (outside release binary folder & never inside container writable layer!)
SNOWFLAKE_WORKER_ID=1
DATABASE_URL=sqlite:///var/lib/keepdays/db/keepdays.db?mode=rwc
LOCAL_S3_DIR=/var/lib/keepdays/uploads
AGENT_FS_DIR=/var/lib/keepdays/agent_fs

# Bounded In-Memory Cache (saves ~40MB Redis daemon RAM on 512MB machine)
REDIS_URL=memory://

# Security Secrets (deploy-ssh.sh auto-generates unique 64-char hex secrets on first install!)
JWT_SECRET=REPLACE_WITH_AUTO_GENERATED_64_HEX_SECRET
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800

# Out-of-the-box Persistent Origin-Relative Storage (/var/lib/keepdays/uploads with SigV4 HMAC!)
# Works immediately over WireGuard (http://10.7.0.1:3090), Public IP, or HTTPS reverse proxy!
# To switch to Cloudflare R2 later, simply replace S3_ENDPOINT/S3_ACCESS_KEY/S3_SECRET_KEY below.
S3_ENDPOINT=/local-s3
S3_REGION=auto
S3_BUCKET=keepdays-private
S3_ACCESS_KEY=keepdays_prod
S3_SECRET_KEY=REPLACE_WITH_AUTO_GENERATED_S3_SECRET
S3_PATH_STYLE=true
S3_PRESIGN_TTL_SECS=1800

# Comma-separated allowed cross-origin frontends (same-origin requests always work automatically)
CORS_ALLOWED_ORIGIN=https://your-domain.example.com
